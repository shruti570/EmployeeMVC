@using DevExtreme.AspNet.Mvc
@using WebProjectMVC.Models
@using DevExtreme.AspNet.Mvc.Builders
@using DevExtreme.AspNet.Mvc

@model IEnumerable<WebProjectMVC.Models.Employee>

<h2>Employee List</h2>

<a asp-controller="Employee"
   asp-action="Create"
   class="btn btn-primary mb-3">
    Add Employee
</a>

@(Html.DevExtreme().DataGrid<Employee>()
    .ID("employeeGrid")

    .DataSource(ds => ds.Mvc()
        .Controller("Employee")
        .LoadAction("GetEmployees")
        .LoadMethod("POST"))
       

    .KeyExpr("SlNo")

    .AllowColumnReordering(true)
    .AllowColumnResizing(true)
    .RowAlternationEnabled(true)
    .Width("100%")
    .ShowBorders(true)

    .SearchPanel(s => s
        .Visible(true)
        .HighlightCaseSensitive(false))

    .GroupPanel(g => g
        .Visible(true))

    .Grouping(g => g
        .AutoExpandAll(false))

    .Paging(p => p
        .PageSize(10))

    .Pager(p => p
        .Visible(true)
        .ShowPageSizeSelector(true)
        .AllowedPageSizes(new[] { 10, 25, 50, 100 }))

    .Columns(columns =>
    {
        columns.AddFor(m => m.Empname)
            .Caption("Employee Name")
            .DataType(GridColumnDataType.String);

        columns.AddFor(m => m.EmpCode)
            .Caption("Employee Code")
            .DataType(GridColumnDataType.String);

        columns.AddFor(m => m.ReportingPersonName)
            .Caption("Reporting Person")
            .DataType(GridColumnDataType.String);

        columns.AddFor(m => m.DepartmentName)
            .Caption("Department")
            .DataType(GridColumnDataType.String);

        columns.AddFor(m => m.CreatedBY)
            .Caption("Created BY")
            .DataType(GridColumnDataType.String);

        columns.AddFor(m => m.ModifiedBY)
            .Caption("Modified BY")
            .DataType(GridColumnDataType.String);

        columns.AddFor(m => m.Salary)
            .Caption("Salary")
            .DataType(GridColumnDataType.Number);

        columns.Add()
       .Caption("Action")
       .Width(250)
       .CellTemplate(new JS(@"
        function(container, options) {

            var id = options.data.SlNo;

            $('<a>')
                .attr('href', '/Employee/Details?id=' + id)
                .addClass('btn btn-sm btn-info me-1')
                .text('View')
                .appendTo(container);

            $('<a>')
                .attr('href', '/Employee/Edit?id=' + id)
                .addClass('btn btn-sm btn-warning me-1')
                .text('Edit')
                .appendTo(container);

            $('<a>')
                .attr('href', '/Employee/Delete?id=' + id)
                .addClass('btn btn-sm btn-danger')
                .text('Delete')
                .appendTo(container);
        }
    "));
    })
)

