@model WebProjectMVC.Models.Employee

@{
    ViewData["Title"] = "Add Employee";
}

<h2>Add Employee</h2>
<hr />

<form asp-action="Create" asp-controller="Employee" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <!-- Calls the form components partial block -->
    <partial name="_EmployeeForm" model="Model" />

    <!-- Button layout grid matching Row 1 field margins perfectly -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-6">
        <div class="flex gap-3">
            <button type="submit" class="btn btn-primary" style="width: 110px;">
                Save
            </button>

            <a asp-action="Index" asp-controller="Employee" class="btn btn-secondary" style="width: 110px; display: inline-flex; align-items: center; justify-content: center;">
                Cancel
            </a>
        </div>
        <div></div>
        <div></div>
        <div></div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
