@model WebProjectMVC.Models.Employee

@{
    // Check if the page is being opened in a read-only View mode from the controller
    bool isViewMode = ViewBag.IsViewMode ?? false;
}

<h2>@(isViewMode ? "View Employee Details" : "Edit Employee")</h2>

<form asp-controller="Employee" asp-action="Edit" method="post">

    <!-- This calls your reusable layout form cleanly -->
    <partial name="_EmployeeForm" model="Model" />

    <div class="mt-4">
        <!-- FIXED: Only show the submit Save button if we are NOT in View mode -->
        @if (!isViewMode)
        {
            <button type="submit" class="btn btn-primary">Save</button>
        }
        <a asp-controller="Employee" asp-action="Index" class="btn btn-secondary">
            @(isViewMode ? "Back to List" : "Cancel")
        </a>
    </div>

</form>
