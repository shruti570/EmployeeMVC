@model WebProjectMVC.Models.Employee

@{
    bool isViewMode = ViewBag.IsViewMode ?? false;
}

<input type="hidden" asp-for="SlNo" />

<div class="row">

    <!-- Employee Name - READ ONLY -->
    <div class="col-md-6 mb-3">
        <label class="form-label">Employee Name</label>
        <input asp-for="Empname" class="form-control" readonly />
    </div>

    <div class="col-md-6 mb-3">
        <label class="form-label">Employee Code</label>
        <input asp-for="EmpCode" class="form-control" readonly />
    </div>

    <!-- Reporting Person - POPULATED FROM BACKEND SP -->
    <div class="col-md-6 mb-3">
        <label class="form-label">Reporting Person</label>
        <select asp-for="ReportingPerson" 
                asp-items="(List<SelectListItem>)ViewBag.ReportingPersons" 
                class="form-control" 
                disabled="@isViewMode">
            <option value="">-- Select Reporting Person --</option>
        </select>
    </div>

    <!-- Department - POPULATED FROM BACKEND SP -->
    <div class="col-md-6 mb-3">
        <label class="form-label">Department</label>
        <select asp-for="DepartmentId" 
                asp-items="(List<SelectListItem>)ViewBag.Departments" 
                class="form-control" 
                disabled="@isViewMode">
            <option value="">-- Select Department --</option>
        </select>
    </div>

    <!-- Salary - READ ONLY -->
    <div class="col-md-6 mb-3">
        <label class="form-label">Salary</label>
        <input asp-for="Salary" class="form-control" readonly />
    </div>

    <!-- Created By - READ ONLY -->
    <div class="col-md-6 mb-3">
        <label class="form-label">Created By</label>
        <input asp-for="CreatedBY" class="form-control" readonly />
    </div>

    <!-- Modified By - READ ONLY -->
    <div class="col-md-6 mb-3">
        <label class="form-label">Modified By</label>
        <input asp-for="ModifiedBY" class="form-control" readonly />
    </div>

</div>
